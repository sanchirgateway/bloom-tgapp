{
	"name": "bloomy-tgapp",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n vite,tunnel -c cyan,magenta \"vite\" \"pnpm tunnel\"",
		"dev:local": "vite",
		"tunnel": "ssh -p 443 -R0:localhost:5173 free.pinggy.io",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tma.js/sdk-react": "^3.0.23",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/telegram-web-app": "^10.1.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"concurrently": "^10.0.5",
		"eruda": "^3.4.3",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.9",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.3.0"
	}
}
